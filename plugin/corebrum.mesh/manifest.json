{
  "schemaVersion": 1,
  "id": "corebrum.mesh",
  "name": "Corebrum",
  "version": "0.1.0",
  "author": "clm",
  "license": "MIT",
  "description": "Corebrum mesh status in the bar: start or stop, open the session or web UI.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Corebrum",
    "description": "Left = start/stop · right = Corebrum menu",
    "category": "Plugin",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 5
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 2,
        "max": 300,
        "step": 1,
        "defaultValue": 5
      }
    ]
  }
}
